{
  "name": "smartspend-backend",
  "version": "1.0.0",
  "description": "SmartSpend REST API (Express + PostgreSQL via pg)",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node src/db/runSql.js sql/schema.sql",
    "db:seed": "node src/db/runSql.js sql/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
